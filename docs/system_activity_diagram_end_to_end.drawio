<mxfile host="app.diagrams.net" modified="2026-09-22T21:30:00.000Z" agent="Antigravity AI Agent" version="24.0.0" type="device"><diagram id="team04-activity-diagram" name="End-to-End System Activity Diagram"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="3700" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_banner" value="&amp;lt;b&amp;gt;&amp;lt;font style='font-size: 16px;'&amp;gt;แผนภาพกิจกรรมการทำงานของระบบแบบครบวงจร (End-to-End UML Activity Diagram)&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style='font-size: 12px; color: #555555;'&amp;gt;โครงงานระบบผู้ช่วยสืบค้นและวิเคราะห์ข้อมูลอัจฉริยะ (Text-to-SQL AI Agent System - Team 04)&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9F9;strokeColor=#BDC3C7;strokeWidth=1.5;align=center;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry" /></mxCell><mxCell id="pool" value="ระบบผู้ช่วยวิเคราะห์ข้อมูลอัจฉริยะ (Text-to-SQL AI Agent System)" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=30;horizontal=0;horizontalStack=1;fillColor=#1A252F;fontColor=#FFFFFF;fontSize=14;fontStyle=1;strokeColor=#2C3E50;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1400" height="3580" as="geometry" /></mxCell><mxCell id="lane_user" value="&amp;lt;b&amp;gt;👤 ผู้ใช้งาน (User)&amp;lt;/b&amp;gt;" style="swimlane;html=1;startSize=30;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="pool"><mxGeometry x="0" y="0" width="280" height="3580" as="geometry" /></mxCell><mxCell id="lane_front" value="&amp;lt;b&amp;gt;💻 ส่วนหน้าบ้าน (Frontend: React UI)&amp;lt;/b&amp;gt;" style="swimlane;html=1;startSize=30;fillColor=#E8F8F5;strokeColor=#16A085;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="pool"><mxGeometry x="0" y="0" width="340" height="3580" as="geometry" /></mxCell><mxCell id="lane_back" value="&amp;lt;b&amp;gt;⚙️ ระบบหลังบ้าน &amp; AI (FastAPI / Agent / Security)&amp;lt;/b&amp;gt;" style="swimlane;html=1;startSize=30;fillColor=#FEF9E7;strokeColor=#D4AC0D;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="pool"><mxGeometry x="0" y="0" width="480" height="3580" as="geometry" /></mxCell><mxCell id="lane_db" value="&amp;lt;b&amp;gt;🗄️ สภาพแวดล้อมฐานข้อมูล (SQLite Sandbox)&amp;lt;/b&amp;gt;" style="swimlane;html=1;startSize=30;fillColor=#F5EEF8;strokeColor=#8E44AD;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="pool"><mxGeometry x="0" y="0" width="300" height="3580" as="geometry" /></mxCell><mxCell id="ban_act1" value="&amp;lt;b&amp;gt;กิจกรรมที่ 1: การนำเข้าไฟล์และตรวจสอบความปลอดภัยข้อมูล (Data Ingestion &amp;amp; Security Validation)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C3E50;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_back"><mxGeometry x="10" y="45" width="460" height="26" as="geometry" /></mxCell><mxCell id="start_1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2ECC71;strokeColor=#27AE60;strokeWidth=2;shadow=1;" vertex="1" parent="lane_user"><mxGeometry x="125" y="80" width="30" height="30" as="geometry" /></mxCell><mxCell id="act1_1" value="&amp;lt;b&amp;gt;1. เลือกไฟล์ข้อมูล&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;กดปุ่มนำเข้าและเลือกไฟล์&amp;lt;br&amp;gt;(.csv, .xlsx, .xls, .tsv, .txt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#34495E;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_user"><mxGeometry x="40" y="130" width="200" height="55" as="geometry" /></mxCell><mxCell id="e1_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="start_1" target="act1_1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_2" value="&amp;lt;b&amp;gt;2. ตรวจสอบไฟล์เบื้องต้น&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ขนาดไฟล์ (&amp;amp;le; 20MB)&amp;lt;br&amp;gt;และนามสกุลไฟล์ที่รองรับ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="70" y="130" width="200" height="55" as="geometry" /></mxCell><mxCell id="e1_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_1" target="act1_2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec1_1" value="ไฟล์ถูกต้อง&amp;lt;br&amp;gt;ตามเกณฑ์?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_front"><mxGeometry x="110" y="215" width="120" height="65" as="geometry" /></mxCell><mxCell id="e1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_2" target="dec1_1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_err" value="&amp;lt;b&amp;gt;แจ้งเตือนข้อผิดพลาด&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ไฟล์เกินขนาด / นามสกุลผิด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;strokeWidth=1.5;fontSize=10;" vertex="1" parent="lane_front"><mxGeometry x="20" y="305" width="140" height="45" as="geometry" /></mxCell><mxCell id="end_1a" value="" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E74C3C;strokeColor=#C0392B;strokeWidth=2;shadow=1;" vertex="1" parent="lane_front"><mxGeometry x="75" y="375" width="30" height="30" as="geometry" /></mxCell><mxCell id="e1_err1" value="[ไม่ถูกต้อง]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec1_1" target="act1_err" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_err2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="act1_err" target="end_1a" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_req" value="&amp;lt;b&amp;gt;ส่งคำขอ API&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;POST /upload-csv (Multipart)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="180" y="305" width="150" height="45" as="geometry" /></mxCell><mxCell id="e1_ok" value="[ถูกต้อง]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec1_1" target="act1_req" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_3" value="&amp;lt;b&amp;gt;3. ตรวจจับ Encoding อัตโนมัติ&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;UTF-8, TIS-620, Windows-874" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="305" width="250" height="45" as="geometry" /></mxCell><mxCell id="e1_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_req" target="act1_3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_4" value="&amp;lt;b&amp;gt;4. Type Inference&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;จำแนกประเภทข้อมูลอัตโนมัติ&amp;lt;br&amp;gt;(Integer, Float, DateTime, Text)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="375" width="250" height="50" as="geometry" /></mxCell><mxCell id="e1_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_3" target="act1_4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_5" value="&amp;lt;b&amp;gt;5. PII Detection (Regex)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ตรวจหาบัตร ปชช. 13 หลัก, เบอร์โทร,&amp;lt;br&amp;gt;อีเมล, และเลขบัตรเครดิต" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="450" width="250" height="55" as="geometry" /></mxCell><mxCell id="e1_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_4" target="act1_5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_6" value="&amp;lt;b&amp;gt;6. Sanitize Column Names&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;จัดระเบียบและตัดอักขระพิเศษในชื่อคอลัมน์" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="530" width="250" height="45" as="geometry" /></mxCell><mxCell id="e1_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_5" target="act1_6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_7" value="&amp;lt;b&amp;gt;7. DDL Operation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;สร้างตารางใหม่ หรือ Overwrite&amp;lt;br&amp;gt;ทับตารางเดิม (DROP IF EXISTS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F4ECF7;strokeColor=#7D3C98;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_db"><mxGeometry x="40" y="530" width="220" height="50" as="geometry" /></mxCell><mxCell id="e1_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_6" target="act1_7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_8" value="&amp;lt;b&amp;gt;8. Insert Batch Data&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;บันทึกข้อมูลทุกแถวลงในตาราง SQLite&amp;lt;br&amp;gt;(เปิด WAL Mode ปลอดภัย)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F4ECF7;strokeColor=#7D3C98;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_db"><mxGeometry x="40" y="605" width="220" height="50" as="geometry" /></mxCell><mxCell id="e1_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_7" target="act1_8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_9" value="&amp;lt;b&amp;gt;9. รวบรวมและส่งผลลัพธ์&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ส่ง Response: table_name, row_count,&amp;lt;br&amp;gt;schema, pii_warnings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="605" width="250" height="50" as="geometry" /></mxCell><mxCell id="e1_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_8" target="act1_9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act1_10" value="&amp;lt;b&amp;gt;10. แสดงผลสำเร็จ&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แสดงพรีวิว 10 แถวแรก, แจ้งเตือน PII,&amp;lt;br&amp;gt;และตั้งชื่อห้อง: &amp;lt;i&amp;gt;'ชุดข้อมูล: &amp;amp;lt;table&amp;amp;gt;'&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="600" width="240" height="60" as="geometry" /></mxCell><mxCell id="e1_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_9" target="act1_10" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="trans_1_2" value="&amp;amp;#10148; ชุดข้อมูลพร้อมใช้งาน &amp;amp;rarr; เริ่มต้นการสืบค้นข้อมูลในกิจกรรมที่ 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#95A5A6;strokeWidth=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="lane_front"><mxGeometry x="30" y="690" width="280" height="26" as="geometry" /></mxCell><mxCell id="e1_trans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act1_10" target="trans_1_2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ban_act2" value="&amp;lt;b&amp;gt;กิจกรรมที่ 2: การแปลงคำถามภาษาธรรมชาติเป็น SQL และการซ่อมแซมคำสั่งอัตโนมัติ (NL-to-SQL &amp;amp; Self-Correction)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C3E50;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_back"><mxGeometry x="10" y="730" width="460" height="26" as="geometry" /></mxCell><mxCell id="act2_1" value="&amp;lt;b&amp;gt;11. พิมพ์คำถามภาษาไทย&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;เช่น &amp;lt;i&amp;gt;'แสดงยอดขาย 5 อันดับแรก&amp;lt;br&amp;gt;แยกตามภาค'&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#34495E;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_user"><mxGeometry x="40" y="780" width="200" height="55" as="geometry" /></mxCell><mxCell id="e2_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="trans_1_2" target="act2_1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_2" value="&amp;lt;b&amp;gt;12. ตรวจสอบคำถาม&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ข้อความไม่ว่าง และตัดช่องว่างส่วนเกิน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="70" y="780" width="200" height="55" as="geometry" /></mxCell><mxCell id="e2_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_1" target="act2_2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_3" value="&amp;lt;b&amp;gt;13. ส่งคำขอ Query&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แสดง Loading Animation + ยิง&amp;lt;br&amp;gt;POST /query (พร้อม Context 5 ข้อความ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="70" y="860" width="200" height="55" as="geometry" /></mxCell><mxCell id="e2_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_2" target="act2_3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_4" value="&amp;lt;b&amp;gt;14. Rate Limiter Guard&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ตรวจสอบโควตา Client IP (&amp;amp;le; 120 req/m)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="860" width="250" height="45" as="geometry" /></mxCell><mxCell id="e2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_3" target="act2_4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec2_1" value="เกินโควตา&amp;lt;br&amp;gt;Rate Limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="180" y="930" width="120" height="60" as="geometry" /></mxCell><mxCell id="e2_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_4" target="dec2_1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_429" value="&amp;lt;b&amp;gt;HTTP 429 Too Many Requests&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แจ้งเตือนผู้ใช้ให้รอ 1 นาที" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;strokeWidth=1.5;fontSize=10;" vertex="1" parent="lane_back"><mxGeometry x="20" y="1010" width="160" height="45" as="geometry" /></mxCell><mxCell id="end_2a" value="" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E74C3C;strokeColor=#C0392B;strokeWidth=2;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="85" y="1075" width="30" height="30" as="geometry" /></mxCell><mxCell id="e2_err1" value="[เกิน 120 req/m]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_1" target="act2_429" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_err2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;" edge="1" source="act2_429" target="end_2a" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_5" value="&amp;lt;b&amp;gt;15. Schema Inspector&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ดึงชื่อตาราง, คอลัมน์, ประเภทข้อมูล,&amp;lt;br&amp;gt;และสุ่มตัวอย่างข้อมูลจริง 3 แถว" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="200" y="1010" width="260" height="50" as="geometry" /></mxCell><mxCell id="e2_ok1" value="[ไม่เกินโควตา]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_1" target="act2_5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_6" value="&amp;lt;b&amp;gt;16. Prompt Builder&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ประกอบ Schema + คำถามภาษาไทย +&amp;lt;br&amp;gt;กฎความปลอดภัย + ตัวอย่าง Few-shot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="200" y="1085" width="260" height="55" as="geometry" /></mxCell><mxCell id="e2_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_5" target="act2_6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_7" value="&amp;lt;b&amp;gt;17. LLM Synthesis (Groq API)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ส่งต่อไปยัง LLaMA 3.3 70B&amp;lt;br&amp;gt;สังเคราะห์คำสั่ง SQL อัตโนมัติ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="200" y="1165" width="260" height="50" as="geometry" /></mxCell><mxCell id="e2_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_6" target="act2_7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_8" value="&amp;lt;b&amp;gt;18. Security AST Validation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ตรวจสอบโครงสร้าง Abstract Syntax Tree&amp;lt;br&amp;gt;อนุญาตเฉพาะคำสั่ง SELECT เท่านั้น" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="200" y="1240" width="260" height="50" as="geometry" /></mxCell><mxCell id="e2_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_7" target="act2_8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec2_sec" value="ผ่านเกณฑ์&amp;lt;br&amp;gt;ความปลอดภัย?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="270" y="1315" width="120" height="60" as="geometry" /></mxCell><mxCell id="e2_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_8" target="dec2_sec" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_sec_err" value="&amp;lt;b&amp;gt;บล็อกคำสั่งอันตราย&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;พบ DROP/DELETE/INSERT/ALTER&amp;lt;br&amp;gt;หรือ Multiple Statements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;strokeWidth=1.5;fontSize=10;" vertex="1" parent="lane_back"><mxGeometry x="80" y="1395" width="170" height="55" as="geometry" /></mxCell><mxCell id="end_2b" value="" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E74C3C;strokeColor=#C0392B;strokeWidth=2;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="150" y="1475" width="30" height="30" as="geometry" /></mxCell><mxCell id="e2_sec_no" value="[คำสั่งอันตราย]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_sec" target="act2_sec_err" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_sec_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;" edge="1" source="act2_sec_err" target="end_2b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_9" value="&amp;lt;b&amp;gt;19. รันคำสั่ง SQL ใน Sandbox&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;SQLite Read-Only Connection&amp;lt;br&amp;gt;Timeout 5 วินาที (WAL Mode)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F4ECF7;strokeColor=#7D3C98;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_db"><mxGeometry x="40" y="1395" width="220" height="55" as="geometry" /></mxCell><mxCell id="e2_sec_yes" value="[เฉพาะ SELECT]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_sec" target="act2_9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec2_exec" value="ผลการรัน SQL&amp;lt;br&amp;gt;สำเร็จหรือไม่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="270" y="1500" width="120" height="65" as="geometry" /></mxCell><mxCell id="e2_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="act2_9" target="dec2_exec" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec2_retry" value="จำนวน Retry&amp;lt;br&amp;gt;&amp;amp;lt; 2 ครั้ง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="120" y="1585" width="110" height="60" as="geometry" /></mxCell><mxCell id="e2_exec_err" value="[เกิด Error]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_exec" target="dec2_retry" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_corr" value="&amp;lt;b&amp;gt;20. Self-Correction Engine&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;นำ Error Message + SQL เดิม + Schema&amp;lt;br&amp;gt;ป้อนกลับให้ AI ปรับแก้ใหม่ (Retry+1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="40" y="1675" width="200" height="55" as="geometry" /></mxCell><mxCell id="e2_retry_yes" value="[Retry &amp;amp;lt; 2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_retry" target="act2_corr" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_loop" value="ส่ง SQL ที่แก้แล้วรันใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="act2_corr" target="act2_9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_fail" value="&amp;lt;b&amp;gt;21. แจ้งเตือนข้อผิดพลาดสุภาพ&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;อธิบายสาเหตุและแนะนำปรับคำถาม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;strokeWidth=1.5;fontSize=10;" vertex="1" parent="lane_back"><mxGeometry x="170" y="1675" width="150" height="50" as="geometry" /></mxCell><mxCell id="end_2c" value="" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E74C3C;strokeColor=#C0392B;strokeWidth=2;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="230" y="1750" width="30" height="30" as="geometry" /></mxCell><mxCell id="e2_retry_no" value="[ครบ 2 รอบ]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_retry" target="act2_fail" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_fail_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;" edge="1" source="act2_fail" target="end_2c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act2_succ" value="&amp;lt;b&amp;gt;22. ดึงชุดข้อมูลผลลัพธ์ (Result Rows)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ได้แถวข้อมูลผลลัพธ์จากการรันสำเร็จ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="260" y="1675" width="200" height="50" as="geometry" /></mxCell><mxCell id="e2_exec_ok" value="[รันสำเร็จ 100%]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec2_exec" target="act2_succ" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="trans_2_3" value="&amp;amp;#10148; ส่ง Result Rows เข้าสู่ระบบวิเคราะห์สถิติและการเลือกกราฟในกิจกรรมที่ 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#95A5A6;strokeWidth=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="lane_back"><mxGeometry x="50" y="1750" width="380" height="26" as="geometry" /></mxCell><mxCell id="e2_trans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act2_succ" target="trans_2_3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ban_act3" value="&amp;lt;b&amp;gt;กิจกรรมที่ 3: การวิเคราะห์ข้อมูลสถิติและการเลือกกราฟอัตโนมัติ (Analytics &amp;amp; Chart Recommendation)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C3E50;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_back"><mxGeometry x="10" y="1795" width="460" height="26" as="geometry" /></mxCell><mxCell id="act3_1" value="&amp;lt;b&amp;gt;23. รับชุดข้อมูลผลลัพธ์ (Rows)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ตรวจสอบจำนวนแถวของข้อมูลที่ส่งมา" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="1840" width="250" height="45" as="geometry" /></mxCell><mxCell id="e3_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="trans_2_3" target="act3_1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec3_rows" value="จำนวนแถว&amp;lt;br&amp;gt;&amp;amp;gt; 0 แถว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_back"><mxGeometry x="180" y="1910" width="120" height="60" as="geometry" /></mxCell><mxCell id="e3_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_1" target="dec3_rows" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_empty" value="&amp;lt;b&amp;gt;24. สรุปไม่พบข้อมูล&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แจ้งเตือน &amp;lt;i&amp;gt;'ไม่พบข้อมูลที่ตรงเงื่อนไข'&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="70" y="1915" width="200" height="50" as="geometry" /></mxCell><mxCell id="end_3a" value="" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E74C3C;strokeColor=#C0392B;strokeWidth=2;shadow=1;" vertex="1" parent="lane_front"><mxGeometry x="20" y="1925" width="30" height="30" as="geometry" /></mxCell><mxCell id="e3_empty_edge" value="[0 แถว]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="dec3_rows" target="act3_empty" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_empty_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#E74C3C;strokeWidth=2;fontColor=#C0392B;" edge="1" source="act3_empty" target="end_3a" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_2" value="&amp;lt;b&amp;gt;25. EDA Analyzer&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แยกแยะคอลัมน์ตัวเลข (Metrics)&amp;lt;br&amp;gt;และคอลัมน์หมวดหมู่/วันที่ (Dimensions)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="1995" width="250" height="50" as="geometry" /></mxCell><mxCell id="e3_has_rows" value="[มีข้อมูล &amp;amp;gt; 0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec3_rows" target="act3_2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_3" value="&amp;lt;b&amp;gt;26. Smart Aggregation &amp;amp;amp; Truncation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;หากผลลัพธ์ &amp;amp;gt; 20 แถว ให้รวมกลุ่ม/ตัดเหลือ&amp;lt;br&amp;gt;Top 20 พร้อมตั้งค่า is_truncated = true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="2070" width="250" height="55" as="geometry" /></mxCell><mxCell id="e3_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_2" target="act3_3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_4" value="&amp;lt;b&amp;gt;27. Chart Recommender Heuristics&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;amp;bull; เปรียบเทียบ &amp;amp;rarr; Bar Chart&amp;lt;br&amp;gt;&amp;amp;bull; ช่วงเวลา/แนวโน้ม &amp;amp;rarr; Line / Area Chart&amp;lt;br&amp;gt;&amp;amp;bull; สัดส่วน (&amp;amp;le; 7 ส่วน) &amp;amp;rarr; Pie Chart&amp;lt;br&amp;gt;&amp;amp;bull; ค่าเดี่ยว &amp;amp;rarr; Summary Card" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="2150" width="250" height="75" as="geometry" /></mxCell><mxCell id="e3_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_3" target="act3_4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_5" value="&amp;lt;b&amp;gt;28. Statistical Summarizer&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;คำนวณสถิติใช้งานจริง: ผลรวม (Total),&amp;lt;br&amp;gt;ค่าเฉลี่ย (Avg), สูงสุด (Max), ต่ำสุด (Min), จำนวน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="2250" width="250" height="55" as="geometry" /></mxCell><mxCell id="e3_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_4" target="act3_5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_6" value="&amp;lt;b&amp;gt;29. เรนเดอร์คำตอบและกล่อง SQL&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แสดงบทสรุปภาษาไทย + กล่องคำสั่ง SQL&amp;lt;br&amp;gt;พร้อมตัววัดระดับความมั่นใจ (Confidence)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2250" width="240" height="55" as="geometry" /></mxCell><mxCell id="e3_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_5" target="act3_6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_7" value="&amp;lt;b&amp;gt;30. เรนเดอร์แท็บกราฟ (Interactive)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;สลับ Bar / Line / Pie / Area ได้ทันที&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;ปุ่ม 'ส่งออก PNG' (2x Retina พื้นหลังขาว)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2330" width="240" height="60" as="geometry" /></mxCell><mxCell id="e3_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_6" target="act3_7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_8" value="&amp;lt;b&amp;gt;31. เรนเดอร์แท็บตาราง (Data Table)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แสดงข้อมูลทุกแถว + ปุ่มดาวน์โหลด CSV&amp;lt;br&amp;gt;(ฟอร์แมต UTF-8 BOM ภาษาไทยสมบูรณ์)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2415" width="240" height="55" as="geometry" /></mxCell><mxCell id="e3_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_7" target="act3_8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act3_9" value="&amp;lt;b&amp;gt;32. แสดงปุ่ม '📌 ปักหมุด'&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;เปิดให้ผู้ใช้กดนำผลลัพธ์เข้าแดชบอร์ดรวม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2495" width="240" height="45" as="geometry" /></mxCell><mxCell id="e3_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act3_8" target="act3_9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="trans_3_4" value="&amp;amp;#10148; ผู้ใช้งานมีปฏิสัมพันธ์กับผลลัพธ์ในกิจกรรมที่ 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#95A5A6;strokeWidth=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="lane_user"><mxGeometry x="30" y="2565" width="220" height="26" as="geometry" /></mxCell><mxCell id="e3_trans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="act3_9" target="trans_3_4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ban_act4" value="&amp;lt;b&amp;gt;กิจกรรมที่ 4: การจัดการประวัติการสนทนาและการปักหมุดแดชบอร์ด (Chat History &amp;amp; Pinned Dashboard)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C3E50;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_back"><mxGeometry x="10" y="2615" width="460" height="26" as="geometry" /></mxCell><mxCell id="dec4_user" value="ผู้ใช้เลือก&amp;lt;br&amp;gt;การทำงานใด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="lane_user"><mxGeometry x="80" y="2665" width="120" height="65" as="geometry" /></mxCell><mxCell id="e4_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="trans_3_4" target="dec4_user" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_a1" value="&amp;lt;b&amp;gt;กรณี A: ถามคำถามในห้องใหม่&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ผู้ใช้สร้างห้องใหม่แล้วพิมพ์ถาม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#34495E;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_user"><mxGeometry x="30" y="2760" width="190" height="50" as="geometry" /></mxCell><mxCell id="e4_bra" value="[ทางเลือก A]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec4_user" target="act4_a1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_a2" value="&amp;lt;b&amp;gt;33A. generateSessionTitle()&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แปลงคำถามแรกเป็นชื่อหัวข้อกระชับ&amp;lt;br&amp;gt;(ตัดคำว่า ขอ, ช่วย, แสดง, ค้นหา)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2760" width="240" height="55" as="geometry" /></mxCell><mxCell id="e4_a1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_a1" target="act4_a2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_a3" value="&amp;lt;b&amp;gt;34A. ซิงค์ชื่อลงฐานข้อมูล&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ส่ง PUT /sessions/{id} บันทึกชื่อ&amp;lt;br&amp;gt;ลงตาราง chat_sessions ใน SQLite" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEFDE8;strokeColor=#B7950B;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_back"><mxGeometry x="115" y="2760" width="250" height="55" as="geometry" /></mxCell><mxCell id="e4_a2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_a2" target="act4_a3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_a4" value="&amp;lt;b&amp;gt;35A. อัปเดต Sidebar&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แสดงชื่อห้องใหม่อย่างสะอาดตา&amp;lt;br&amp;gt;(ตัดคำว่า 'ล่าสุด' ออกเรียบร้อย)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2840" width="240" height="50" as="geometry" /></mxCell><mxCell id="e4_a3_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_a3" target="act4_a4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_b1" value="&amp;lt;b&amp;gt;กรณี B: กดปุ่ม '📌 ปักหมุด'&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ต้องการบันทึกการ์ดเข้าแดชบอร์ด" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#34495E;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_user"><mxGeometry x="40" y="2920" width="180" height="50" as="geometry" /></mxCell><mxCell id="e4_brb" value="[ทางเลือก B]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec4_user" target="act4_b1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_b2" value="&amp;lt;b&amp;gt;33B. ส่ง POST /pinned-dashboard&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ส่ง Payload: title, visualization,&amp;lt;br&amp;gt;sql, text summary, sessionId" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="2920" width="240" height="55" as="geometry" /></mxCell><mxCell id="e4_b1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_b1" target="act4_b2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_b3" value="&amp;lt;b&amp;gt;34B. Insert pinned_items&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;บันทึกข้อมูลและ Content JSON&amp;lt;br&amp;gt;ลงตาราง pinned_items" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F4ECF7;strokeColor=#7D3C98;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_db"><mxGeometry x="40" y="2920" width="220" height="55" as="geometry" /></mxCell><mxCell id="e4_b2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_b2" target="act4_b3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_b4" value="&amp;lt;b&amp;gt;35B. แสดง Toast ปักหมุดสำเร็จ&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;พร้อมเปิดให้ผู้ใช้กดดูในแท็บรวม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="3000" width="240" height="45" as="geometry" /></mxCell><mxCell id="e4_b3_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_b3" target="act4_b4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_c1" value="&amp;lt;b&amp;gt;กรณี C: ดูแดชบอร์ดรวม&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;คลิกแท็บ 'แดชบอร์ดรวม'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#34495E;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_user"><mxGeometry x="40" y="3075" width="180" height="50" as="geometry" /></mxCell><mxCell id="e4_brc" value="[ทางเลือก C]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dec4_user" target="act4_c1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_c2" value="&amp;lt;b&amp;gt;33C. ส่ง GET /pinned-dashboard&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ดึงรายการปักหมุดทั้งหมดจาก Backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="3075" width="240" height="50" as="geometry" /></mxCell><mxCell id="e4_c1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_c1" target="act4_c2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_c3" value="&amp;lt;b&amp;gt;34C. Query pinned_items&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;SELECT * FROM pinned_items&amp;lt;br&amp;gt;ORDER BY pinned_at DESC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F4ECF7;strokeColor=#7D3C98;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_db"><mxGeometry x="40" y="3075" width="220" height="50" as="geometry" /></mxCell><mxCell id="e4_c2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_c2" target="act4_c3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act4_c4" value="&amp;lt;b&amp;gt;35C. เรนเดอร์ Dynamic Grid&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;แสดงการ์ดสรุป + กราฟย่อย + รองรับ&amp;lt;br&amp;gt;ปลดหมุด (Unpin) และพิมพ์/PDF" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="3155" width="240" height="60" as="geometry" /></mxCell><mxCell id="e4_c3_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_c3" target="act4_c4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="merge_final" value="จุดรวมการทำงาน (Merge)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E5E8E8;strokeColor=#7F8C8D;fontSize=9;" vertex="1" parent="lane_front"><mxGeometry x="120" y="3255" width="100" height="40" as="geometry" /></mxCell><mxCell id="e4_m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_a4" target="merge_final" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_b4" target="merge_final" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act4_c4" target="merge_final" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_ready" value="&amp;lt;b&amp;gt;ระบบพร้อมรับคำสั่งถัดไป&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ผู้ใช้สามารถพิมพ์ถามต่อหรือจัดการข้อมูลได้ทันที" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=1.5;shadow=1;fontSize=11;align=center;" vertex="1" parent="lane_front"><mxGeometry x="50" y="3325" width="240" height="45" as="geometry" /></mxCell><mxCell id="e4_m_ready" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="merge_final" target="act_ready" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="end_final" value="" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E74C3C;strokeColor=#C0392B;strokeWidth=2;shadow=1;" vertex="1" parent="lane_front"><mxGeometry x="155" y="3400" width="30" height="30" as="geometry" /></mxCell><mxCell id="e4_final_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontColor=#2C3E50;" edge="1" source="act_ready" target="end_final" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>