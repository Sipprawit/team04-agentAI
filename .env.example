# ==========================================
# Text-to-SQL AI Agent - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. AI / LLM Configuration (Backend)
# ------------------------------------------
# ใส่ Groq API Key ของคุณที่นี่ (จำเป็นสำหรับการแปลภาษาเป็น SQL และสรุปผล)
# สมัครและรับ API Key ได้ฟรีที่ https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# โมเดล LLM ที่ต้องการใช้งานบน Groq:
# ตัวเลือกที่แนะนำ:
#   - openai/gpt-oss-20b         (ค่าเริ่มต้น: เร็ว แม่นยำ เหมาะกับ Text-to-SQL)
#   - llama-3.3-70b-versatile   (ประสิทธิภาพสูงสำหรับคำถามซับซ้อน)
#   - qwen/qwen3.6-27b          (รองรับหลายภาษาและคำสั่งโครงสร้างได้ดี)
LLM_MODEL_NAME=openai/gpt-oss-20b

# ------------------------------------------
# 2. Database Configuration (Backend)
# ------------------------------------------
# ที่อยู่ไฟล์ SQLite Database
# สำหรับ Local Development: ./data/test.db หรือ backend/data/test.db
# สำหรับ Docker Compose: /app/data/test.db (มี volume mount อัตโนมัติ)
SQLITE_DB_PATH=./data/test.db

# ------------------------------------------
# 3. Frontend Configuration (Vite)
# ------------------------------------------
# ที่อยู่ Backend API Base URL สำหรับ Frontend
# สำหรับ Local Development: http://localhost:8000
# สำหรับ Docker Compose: ปล่อยว่างไว้เพื่อใช้ Nginx Reverse Proxy
VITE_API_BASE_URL=http://localhost:8000
